# Copy to .env.local and fill in. Never commit .env.local.
# Variables prefixed NEXT_PUBLIC_ are exposed to the browser; everything else is server-only.

# --- App ---
# Public base URL, used for auth redirects, Stripe return URLs and share links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (auth, Postgres, Storage) ---
NEXT_PUBLIC_SUPABASE_URL=
# The anon (or newer "publishable") key. Safe for the browser; RLS protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by the Stripe webhook to grant credits. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (video analysis, server-only) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- OpenAI (Whisper transcription, server-only) ---
OPENAI_API_KEY=

# --- Stripe (test mode) ---
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_
# Price IDs for the paid tiers (created in the Stripe dashboard, test mode).
STRIPE_PRICE_CREATOR=price_
STRIPE_PRICE_PRO=price_
